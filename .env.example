# ── Backend ─────────────────────────────────────────────────────
APP_ID=YOUR_APP_ID
APP_SECRET=YOUR_APP_SECRET

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE  # 只係格式範例；請用秘密管理，唔好提交真連線

# ── AI 相片試穿（server-only；唔好加 VITE_ 前綴）───────────────
FASHN_API_KEY=
PUBLIC_BASE_URL=https://redcode.red
# 預設私人圖片會放喺 UPLOADS_DIR/tryon-private；如另有加密私人 disk 先覆寫以下兩項。
# UPLOADS_DIR=uploads
# TRYON_PRIVATE_DIR=uploads/tryon-private

# ── Glo Glo 精選配搭指南（server-only）──────────────────────────
# WMS → 官網內部端點 /api/wms/glo-guide 嘅 shared secret（同其他 /api/wms/* 共用）
WMS_CALLBACK_SECRET=
# 自動排程：香港週一/週五 09:00 自動生成（true 先啟用；slot 鐘點可改 0–23）
# GLO_GUIDE_AUTOMATION_ENABLED=false
# GLO_GUIDE_SCHEDULE_HOUR=9
# 文案生成直接沿用現有 DeepSeek 三項（server-only；唔好加 VITE_ 前綴）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE=
DEEPSEEK_MODEL=
# 以下只係可選 override／fallback；平時唔使另設一套指南專用 key
# GLO_GUIDE_AI_BASE_URL=
# GLO_GUIDE_AI_API_KEY=
# GLO_GUIDE_AI_MODEL=
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=
# 模特兒原圖而家喺官網 /admin → 精選文章上傳及設預設；呢項只係冇 DB 預設相時嘅可選 fallback。
# 只放真實已授權照片；https 或站內絕對路徑，逗號分隔，實際只用第一項；最後 fallback /gloglo-3.jpg。
# GLO_GUIDE_MODEL_IMAGE_URLS=

# ── 安全加固（2026-11-19 R06/R13/R14/S05；全部可選，有安全預設）────────────
# R06：可信代理層數。Render 單層 proxy 用預設 1（真實 client IP 取 XFF 最尾）；
# 前面加咗 Cloudflare 等 CDN 要先喺 staging 核實 append/overwrite 行為再改 2；
# 0＝完全唔信 XFF（直連部署）。
# TRUSTED_PROXY_COUNT=1
# R13：Airwallex webhook timestamp 容忍窗（毫秒，預設 86400000＝24 小時）。
# 官方 retry 約 3 日且文件冇保證 retry 重簽 timestamp；staging 核實後可收緊（如 300000＝5 分鐘）。
# AIRWALLEX_WEBHOOK_TOLERANCE_MS=86400000
# R14：DB TLS。非 localhost 連線提供 CA 即開完整證書驗證（錯 CA 必敗）；
# Render 內網明文連線請明確設 DATABASE_SSL=disable 確認信任邊界。
# DATABASE_CA_CERT=          # PEM 內容（多行用 \n 或喺平台密鑰管理貼入）
# DATABASE_CA_FILE=          # 或者 PEM 檔案路徑
# DATABASE_SSL=disable       # 明確 opt-out（內網明文）
# S05：VIP 證書驗證簽名專用密鑰（同 JWT_SECRET 分離）。未設會暫用 JWT_SECRET（向後兼容＋警告）；
# 設定後舊 JWT_SECRET 簽名即刻唔再通過——過渡期要接受已印舊證書，另設 VIP_CERT_LEGACY_ACCEPT=1。
# VIP_CERT_SECRET=
# VIP_CERT_LEGACY_ACCEPT=
